# Frontend specific
# Pre-compressed asset variants are NOT committed. Gzip output cannot be
# deflated or delta-compressed by git, and Vite's content-hashed filenames make
# every rebuild a brand new blob, so committing these grew to two thirds of the
# repository history. utils/precompress_assets.py regenerates them at startup.
frontend/dist/**/*.gz
frontend/dist/**/*.br
frontend/dist/**/*.gz.tmp

# frontend/dist/ is built by CI/CD pipeline
frontend/dist/
frontend/.cache/
*.local

# Tailwind CSS output
# **/output.css

# npm cache
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
#frontend/dist

# Windows NUL file
nul

# Personal workspace: your own indicators, research, backtests and notes.
# Only the readme is tracked -- everything else is yours and stays local.
# NOTE: gitignore is not a secrecy boundary. `git add -f` bypasses it, and
# the Docker build copies the repo tree, so workspace/ is excluded in
# .dockerignore too. Real secrets belong in .env or keys/, never here.
workspace/**
!workspace/**/
!workspace/readme.md
!workspace/**/readme.md

# Environment files, everywhere and in every variant. Plain `.env` was
# already covered, but `.env.production` / `.env.bak` / `env.backup` were
# not -- `.env.local` only escaped by accidentally matching `*.local`.
# A committed secret must be rotated, not just deleted, so cast wide.
.env.*
*.env
env.backup
!.sample.env
!**/.sample.env
# ...but the negation above must not punch a hole in workspace/, whose
# promise is that only readmes are tracked. Last matching rule wins.
workspace/**/.sample.env

# Local Git worktrees created for isolated feature and documentation work.
.worktrees/

# Local live-broker backtest/dry-run tooling with a hardcoded API key
# (algodev.co.in) -- personal dev scripts, never meant to be committed.
# A committed secret must be rotated, not just deleted, so keep these out
# of the repo entirely rather than relying on remembering not to `git add`
# them.
strategies/backtest/run_oi_live_backtest.py
strategies/backtest/dry_run_oi_positional_live.py
strategies/backtest/live_backtest_oi_positional_aug2026.py
strategies/backtest/live_backtest_oi_positional_aug2026_always_prevclose.py
# Generated outputs from the scripts above.
oi_live_fixed930_state.json
oi_live_original_state.json
strategies/backtest/results_live/
strategies/backtest/results_live_smoke/
